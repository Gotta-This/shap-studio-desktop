{
  "name": "research-studio-vue-v3",
  "version": "3.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:python": "python3 -m unittest discover -s python -p 'test_*.py' -v",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "format": "prettier --write src vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.0",
    "@lucide/vue": "^1.66.0",
    "@tauri-apps/api": "^2.0.0",
