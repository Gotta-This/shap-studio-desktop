      {
        "key": "alb",
        "name": "Alb",
        "kind": "continuous",
        "positive": {
          "mean": 38,
          "std": 3,
          "min": 20,
          "max": 80
        },
        "negative": {
          "mean": 41,
          "std": 3,
          "min": 20,
          "max": 80
        },
        "transform": "round",
        "digits": 1
      },
      {
        "key": "education",
