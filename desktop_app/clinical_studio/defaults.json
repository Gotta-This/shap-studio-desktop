          "mean": 70,
          "std": 10,
          "min": 20,
          "max": 100
        },
        "negative": {
          "mean": 55,
          "std": 12,
          "min": 20,
          "max": 100
        },
        "transform": "int",
        "digits": 0
      },
      {
        "key": "csvd",
        "name": "CSVD总负荷评分",
        "kind": "continuous",
        "positive": {
          "mean": 2.7,
          "std": 0.8,
          "min": 0.5,
          "max": 5
        },
        "negative": {
          "mean": 1.8,
          "std": 0.5,
          "min": 0.5,
          "max": 5
        },
        "transform": "round",
        "digits": 1
      },
      {
        "key": "age",
        "name": "年龄",
        "kind": "continuous",
        "positive": {
          "mean": 65,
          "std": 11,
          "min": 18,
          "max": 80
        },
        "negative": {
          "mean": 75,
          "std": 11,
          "min": 19,
          "max": 78
        },
        "transform": "round",
        "digits": 1
      },
      {
        "key": "tg",
        "name": "TG",
        "kind": "continuous",
        "positive": {
          "mean": 5.3,
          "std": 1.1,
          "min": 1,
          "max": 10
        },
        "negative": {
          "mean": 4.3,
          "std": 1.1,
          "min": 1,
          "max": 10
        },
        "transform": "int",
        "digits": 0
