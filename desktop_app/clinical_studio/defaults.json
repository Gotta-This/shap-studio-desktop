        "negative_p": 0.5
      }
    ]
  },
  "model": {
    "test_size": 0.3,
    "stratify": true,
    "split_seed": 42,
    "random_state": 42,
    "max_iter": 1000,
    "solver": "lbfgs",
    "C": 1.0,
    "tol": 0.0001,
    "fit_intercept": true,
    "penalty": "l2",
    "l1_ratio": 0.5,
    "class_weight": "none",
    "threshold": 0.5
